          "request": {
            "name": "List Application Details",
            "description": {
              "content": "Returns the consolidated detail of all investment applications across the available application types (committed, fund, deposit, COE). Supports filtering by application type, date range, account, link, investment and institution. Results are paginated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "applications",
                "details"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "applicationType",
                  "value": "<string>",
                  "description": "Application type to filter by. Can be repeated to include multiple types. Defaults to all four types."
                },
                {
                  "disabled": false,
                  "key": "dateFrom",
                  "value": "<string>",
                  "description": "Lower bound (inclusive) for the application date. Format: YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "dateTo",
                  "value": "<string>",
                  "description": "Upper bound (inclusive) for the application date. Format: YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "accountId",
                  "value": "<string>",
                  "description": "Filter by one or more account IDs. Can be repeated."
                },
                {
                  "disabled": false,
                  "key": "linkId",
                  "value": "<string>",
                  "description": "Filter by one or more link IDs. Can be repeated."
                },
                {
                  "disabled": false,
                  "key": "investmentId",
                  "value": "<string>",
                  "description": "Filter by one or more investment IDs. Can be repeated."
                },
                {
                  "disabled": false,
                  "key": "institutionId",
                  "value": "<string>",
                  "description": "Filter by one or more institution IDs. Can be repeated."
                }
              ],
              "variable": []
            },
