              {
                "name": "transactionId",
                "value": "",
                "type": "query",
                "description": "Transaction identifier"
              },
              {
                "name": "reference",
                "value": "",
                "type": "query",
                "description": "Reference"
              },
              {
                "name": "categoryId",
                "value": "",
                "type": "query",
                "description": "Category identifier"
              }
            ]
          },
          "docs": "List payments. Role: ROLE_PAYMENTS_READ."
